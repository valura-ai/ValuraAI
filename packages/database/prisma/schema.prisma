// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  cognitoId      String   @id @map("cognito_id")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  mobileNumber   String   @map("mobile_number")
  isUae          Boolean  @map("is_uae")
  inquiryId      String?  @unique @map("inquiry_id")
  kycStatus      String   @map("kyc_status")
  category       String   @default("Unknown") @map("category")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  watchlists     Watchlist[]
}

model FinancialInstrument {
  symbol   String   @id
  name     String
  type     String
  currency String
  watchlists Watchlist[]
}

model Watchlist {
  watchlistId String   @id @map("watchlist_id")
  userId      String   @map("user_id")
  symbol      String   @map("symbol")
  addedAt     DateTime @map("added_at")

  user        User      @relation(fields: [userId], references: [cognitoId])
  instrument  FinancialInstrument @relation(fields: [symbol], references: [symbol])

  @@unique([userId, symbol]) // Prevent duplicate entries for the same user and instrument
}

// Enums and other configurations remain unchanged